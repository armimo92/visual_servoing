<launch>
    <include file="$(find fa_hex_ibvs)/launch/spawn_sdf.launch">
        <arg name="robot_name" value="faHex" />
        <arg name="x" value="0.0" />
        <arg name="y" value="0.0" />
        <arg name="z" value="0.0" />
        <arg name="roll" value="0.0" />
        <arg name="pitch" value="0.0" />
        <arg name="yaw" value="0.0" />
        <arg name="sdf_robot_file" value="$(find fa_hex_ibvs)/models/fa_hex/model.sdf" />
    </include>
</launch>
