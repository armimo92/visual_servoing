<launch>
    <include file="$(find test_gazebo)/launch/spawn_sdf.launch">
        <arg name="robot_name" value="grass_floor" />
        <arg name="x" value="0.0" />
        <arg name="y" value="0.0" />
        <arg name="z" value="0.0" />
        <arg name="roll" value="0.0" />
        <arg name="pitch" value="0.0" />
        <arg name="yaw" value="0.0" />
        <arg name="sdf_robot_file" value="$(find test_gazebo)/models/grass/model.sdf" />
    </include>
</launch>
