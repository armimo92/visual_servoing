	cd /home/armando/Documents/visual_servoing_ws/build && $(MAKE) -f fxteso_asgibvs/CMakeFiles/aibvs_uav_node.dir/build.make fxteso_asgibvs/CMakeFiles/aibvs_uav_node.dir/src/uav_dynamics.cpp.i
.PHONY : src/uav_dynamics.cpp.i

src/uav_dynamics.s: src/uav_dynamics.cpp.s

.PHONY : src/uav_dynamics.s

# target to generate assembly for a file
src/uav_dynamics.cpp.s:
	cd /home/armando/Documents/visual_servoing_ws/build && $(MAKE) -f fxteso_asgibvs/CMakeFiles/aibvs_uav_node.dir/build.make fxteso_asgibvs/CMakeFiles/aibvs_uav_node.dir/src/uav_dynamics.cpp.s
.PHONY : src/uav_dynamics.cpp.s

